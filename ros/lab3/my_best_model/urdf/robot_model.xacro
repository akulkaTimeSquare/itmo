<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
    <!-- 10 links, joints: RRPR CCCC + 1 fixed to 10th link -->
    <xacro:property name="base_length" value="0.2"/>
    <xacro:property name="base_width"  value="0.18"/>
    <xacro:property name="base_height" value="0.12"/>

    <xacro:property name="wheel_radius" value="0.035"/>
    <xacro:property name="wheel_width" value="0.02"/>

    <xacro:property name="x_offset" value="0.025"/>
    <xacro:property name="y_offset" value="0.02"/>
    <xacro:property name="z_offset" value="0.015"/>

    <xacro:property name="arm1_length" value="${base_length*0.325}"/>
    <xacro:property name="arm1_width" value="${base_width*0.325}"/>
    <xacro:property name="arm1_height" value="${base_height}"/>

    <xacro:property name="arm2_radius" value="${wheel_radius*0.375}"/>
    <xacro:property name="arm2_length" value="${base_length}"/>

    <xacro:property name="arm3_length" value="0.015"/>
    <xacro:property name="arm3_width" value="0.015"/>
    <xacro:property name="arm3_height" value="0.1"/>

    <xacro:property name="arm4_radius" value="0.008"/>
    <xacro:property name="arm4_length" value="0.12"/>

    <xacro:property name="arm5_radius" value="0.025"/>

    <xacro:include filename="$(find my_best_model)/urdf/materials.xacro"/>
    <xacro:include filename="$(find my_best_model)/urdf/wheel.xacro"/>
    
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

    <!-- base -->
    <link name='base_link'>
        <visual name='base_visual'>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <!-- wheels -->
    <xacro:wheel side="fr" x="${-base_length/2 - x_offset}" y="${base_width/4 + y_offset}" z="${-base_height/2 + z_offset}"/>
    <xacro:wheel side="fl" x="${base_length/2 + x_offset}" y="${base_width/4 + y_offset}" z="${-base_height/2 + z_offset}"/>
    <xacro:wheel side="bl" x="${base_length/2 + x_offset}" y="${-base_width/4 - y_offset}" z="${-base_height/2 + z_offset}"/>
    <xacro:wheel side="br" x="${-base_length/2 - x_offset}" y="${-base_width/4 - y_offset}" z="${-base_height/2 + z_offset}"/>

    <!-- arm1 -->
    <link name="arm_link1">
        <visual>
            <origin xyz="0 0 ${arm1_height/2}" rpy="0 0 0"/>
        <geometry>
            <box size="${arm1_length} ${arm1_width} ${arm1_height}"/>
        </geometry>
        <material name="blue"/>
        </visual>
    </link>

    <joint name="arm_joint1" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link1"/>
        <origin xyz="0 0 ${base_height/2 + z_offset/4}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-pi}" upper="${pi}" effort="10" velocity="1.0"/>
    </joint>

    <!-- arm2 -->
    <link name="arm_link2">
        <visual>
            <origin xyz="0 0 ${arm2_length/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${arm2_radius}" length="${arm2_length}"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name="arm_joint2" type="revolute">
        <parent link="arm_link1"/>
        <child link="arm_link2"/>
        <origin xyz="0 0 ${arm1_height + z_offset*1.75}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${-pi*0.6}" upper="${pi*0.6}" effort="10" velocity="1.0"/>
    </joint>

    <!-- arm3 -->
    <link name="arm_link3">
        <visual>
            <origin xyz="0 0 ${arm3_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${arm3_length} ${arm3_width} ${arm3_height}"/>
            </geometry>
            <material name="orange"/>
        </visual>
    </link>

    <joint name="arm_joint3" type="prismatic">
        <parent link="arm_link2"/>
        <child link="arm_link3"/>
        <origin xyz="0 0 ${arm2_length + z_offset*3/4}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="0.06" effort="5" velocity="0.1"/>
    </joint>

    <!-- arm4 -->
    <link name="arm_link4">
    <visual>
        <origin xyz="0 0 ${arm4_length/2}" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="${arm4_radius}" length="${arm4_length}"/>
        </geometry>
        <material name="red"/>
    </visual>
    </link>

    <joint name="arm_joint4" type="revolute">
        <parent link="arm_link3"/>
        <child link="arm_link4"/>
        <origin xyz="0 0 ${arm3_height + z_offset*3/4}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${-pi*0.475}" upper="${pi*0.475}" effort="5" velocity="1.5"/>
    </joint>

    <!-- arm5 -->
    <link name="arm_link5">
        <visual>
            <origin xyz="0 0 ${arm5_radius}" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${arm5_radius}"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <joint name="arm_joint5" type="fixed">
        <parent link="arm_link4"/>
        <child link="arm_link5"/>
        <origin xyz="0 0 ${arm4_length + z_offset/5}" rpy="0 0 0"/>
    </joint>
</robot>