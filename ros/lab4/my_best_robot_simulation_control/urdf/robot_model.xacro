<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
    <!-- includes -->
    <xacro:include filename="$(find my_best_robot_simulation_control)/urdf/materials.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_control)/urdf/wheel.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_control)/urdf/inertia.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_control)/urdf/caster.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_control)/urdf/robot_model.gazebo"/>

    <!-- parameters -->
    <xacro:property name="base_length" value="0.2"/>
    <xacro:property name="base_width"  value="0.18"/>
    <xacro:property name="base_height" value="0.12"/>
    <xacro:property name="base_mass" value="1"/>

    <xacro:property name="wheel_radius" value="0.045"/>
    <xacro:property name="wheel_width" value="0.02"/>
    <xacro:property name="wheel_mass" value="0.5"/>

    <xacro:property name="x_offset" value="0.01"/>
    <xacro:property name="y_offset" value="0.02"/>
    <xacro:property name="z_offset" value="0.025"/>

    <xacro:property name="sphere_radius" value="${wheel_radius - z_offset}"/>

    <!-- ros2 control -->
    <ros2_control name="DiffBotSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="wheel_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="wheel_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <!-- dummy for base inertia -->
    <link name="dummy"/>

    <joint name="base_joint" type="fixed">
        <parent link="dummy"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- base -->
    <link name='base_link'>
        <pose> 0 0 0 0 0 0 </pose>
        <visual name='base_visual'>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0." rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>

        <xacro:caster n="1" x="${base_length*0.4}" y="0" z="${-base_height/2}" radius="${sphere_radius}">
        </xacro:caster>
        
        <xacro:caster n="2" x="${-base_length*0.4}" y="0" z="${-base_height/2}" radius="${sphere_radius}">
        </xacro:caster>
    </link>

    <!-- wheels -->
    <xacro:wheel side="left" x="0" y="${base_width/2 + y_offset}" z="${-base_height/2 + z_offset}">
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </xacro:wheel>

    <xacro:wheel side="right" x="0" y="${-base_width/2 - y_offset}" z="${-base_height/2 + z_offset}">
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </xacro:wheel>
</robot>
