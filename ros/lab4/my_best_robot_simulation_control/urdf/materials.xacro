<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="materials">
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    
    <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
    </material>
    
    <material name="green">
        <color rgba="${30/255} ${255/255} ${30/255} 1.0"/>
    </material>
    
    <material name="gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    
    <material name="burgundy">
        <color rgba="${128/255} ${0/255} ${32/255} 1.0"/>
    </material>

    <material name="burgundy_warm">
        <color rgba="${140/255} ${20/255} ${40/255} 1.0"/>
    </material>

    <material name="burgundy_dark">
        <color rgba="${90/255} ${0/255} ${25/255} 1.0"/>
    </material>

    <material name="orange">
        <color rgba="${255/255} ${108/255} ${10/255} 1.0"/>
    </material>

    <material name="brown">
        <color rgba="${222/255} ${207/255} ${195/255} 1.0"/>
    </material>
    
    <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
    </material>
    
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
</robot>