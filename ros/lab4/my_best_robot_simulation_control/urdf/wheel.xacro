<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
    <xacro:macro name="wheel" params="side x y z *inertial">
        <link name="wheel_${side}_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:insert_block name="inertial"/>
        </link>

        <joint name="wheel_${side}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="wheel_${side}_link"/>
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <transmission name="tran_{side}">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="wheel_{side}_joint">
                <hardwareInterface>
                hardware_interface/VelocityJointInterface
                </hardwareInterface>
            </joint>
            <actuator name="motor_{side}">
                <hardwareInterface>
                hardware_interface/VelocityJointInterface
                </hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>
</robot>