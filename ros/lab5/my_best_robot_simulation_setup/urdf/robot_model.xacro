<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
    <!-- includes -->
    <xacro:include filename="$(find my_best_robot_simulation_setup)/urdf/materials.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_setup)/urdf/wheel.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_setup)/urdf/inertia.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_setup)/urdf/caster.xacro"/>
    <xacro:include filename="$(find my_best_robot_simulation_setup)/urdf/robot_model.gazebo"/>

    <!-- parameters -->
    <xacro:property name="base_length" value="0.2"/>
    <xacro:property name="base_width"  value="0.18"/>
    <xacro:property name="base_height" value="0.12"/>
    <xacro:property name="base_mass" value="5"/>

    <xacro:property name="wheel_radius" value="0.045"/>
    <xacro:property name="wheel_width" value="0.02"/>
    <xacro:property name="wheel_mass" value="0.5"/>

    <xacro:property name="x_offset" value="0.01"/>
    <xacro:property name="y_offset" value="0.02"/>
    <xacro:property name="z_offset" value="0.025"/>

    <xacro:property name="sphere_radius" value="${wheel_radius - z_offset}"/>

    <xacro:property name="camera_length" value="0.04"/>
    <xacro:property name="camera_width"  value="0.04"/>
    <xacro:property name="camera_height" value="0.04"/>
    <xacro:property name="camera_mass" value="0.2"/>

    <xacro:property name="lidar_length" value="0.01"/>
    <xacro:property name="lidar_width"  value="0.01"/>
    <xacro:property name="lidar_height" value="0.01"/>
    <xacro:property name="lidar_mass" value="0.2"/>

    <!-- ros2 control -->
    <ros2_control name="DiffBotSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="wheel_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="wheel_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <!-- dummy for base inertia -->
    <link name="dummy"/>

    <joint name="base_joint" type="fixed">
        <parent link="dummy"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- base -->
    <link name='base_link'>
        <pose> 0 0 0 0 0 0 </pose>
        <visual name='base_visual'>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0." rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>

        <xacro:caster n="1" x="${base_length*0.4}" y="0" z="${-base_height/2}" radius="${sphere_radius}">
        </xacro:caster>
        
        <xacro:caster n="2" x="${-base_length*0.4}" y="0" z="${-base_height/2}" radius="${sphere_radius}">
        </xacro:caster>
    </link>

    <!-- wheels -->
    <xacro:wheel side="left" x="0" y="${base_width/2 + y_offset}" z="${-base_height/2 + z_offset}">
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </xacro:wheel>

    <xacro:wheel side="right" x="0" y="${-base_width/2 - y_offset}" z="${-base_height/2 + z_offset}">
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </xacro:wheel>

    <!-- camera -->
    <link name="camera_link">
        <visual name="camera_link_visual">
            <origin xyz="0 0 0" rpy=" 0 0 0"/>
            <geometry>
            <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
        </visual>

        <collision name="camera_link_colision">
            <origin xyz="0 0 0" rpy=" 0 0 0"/>
            <geometry>
               <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
        </collision>

        <inertial name="camera_link_inertial">
            <origin xyz="0 0 0" rpy=" 0 0 0"/>
                <mass value="${camera_mass}"/>
                <inertia ixx="1e-3" ixy="0" ixz="0"
                    iyy="1e-3" iyz="0"
                    izz="1e-3"/>
        </inertial>
    </link>
    
    <joint name="camera_joint" type="fixed">
        <origin xyz="${base_length/2 - camera_length/2} 0 ${base_height/2 + camera_height/2}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <!-- lidar -->
    <link name="lidar_link">
        <visual name="lidar_visual">
            <geometry>
                <box size="${lidar_length} ${lidar_width} ${lidar_height}" />
            </geometry>

            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="yellow" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${lidar_length} ${lidar_width} ${lidar_height}"/>
            </geometry>
        </collision>
        
        <inertial>
            <mass value="${lidar_mass}"/>
            <inertia ixx="1e-3" ixy="0" ixz="0"
                iyy="1e-3" iyz="0"
                izz="1e-3"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <origin xyz="0 0 ${camera_height/2 + lidar_height/2}" rpy="0 0 0"/>
        <child link="lidar_link"/>
        <parent link="camera_link"/>
    </joint>
</robot>
